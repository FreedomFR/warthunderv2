{
  "name": "naval-combat-sim",
  "version": "0.2.0",
  "description": "WWII naval combat simulation on a real-time WebGPU ocean: real ships by nation and class, autonomous AI fleets.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build": "node build.mjs",
    "test": "node tools/runtests.mjs",
    "check:shaders": "node tools/wgslcheck.mjs",
    "trailer:record": "node tools/trailer/record.mjs",
    "trailer:assemble": "node tools/trailer/assemble.mjs tools/trailer/edit.json",
    "smoke": "node tools/smoke.mjs",
    "test:fast": "node tools/runtests.mjs --fast",
    "test:serial": "node tools/runtests.mjs --serial",
    "map": "node tools/codemap.mjs",
    "lint": "eslint js tools test build.mjs server.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "playwright-core": "^1.54.2"
  }
}
